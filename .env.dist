# ==================================================
# Django
# ==================================================

# Clave secreta de Django
DJANGO_SECRET_KEY=django-insecure-change-me

# Debug: "1" = True, "0" = False
DJANGO_DEBUG=0

# Hosts permitidos (separados por coma)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes CSRF confiables (coma). Ej si se accede por IP/puerto:
# DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.0.50:8000

# Docker: intervalo (segundos) del servicio `sync` de xSys. Default 21600 (6h).
XSYS_SYNC_INTERVAL=21600


# ==================================================
# PostgreSQL
# Si POSTGRES_DB está definido, Django usa Postgres.
# Si NO está definido, usa SQLite.
# ==================================================

POSTGRES_DB=geba_acs
POSTGRES_USER=geba_acs
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433


# ==================================================
# MSSQL - Access Log (BioStar / control de accesos)
# ==================================================

# Habilitar o deshabilitar el log
MSSQL_ACCESS_LOG_ENABLED=1

# Conexión MSSQL
MSSQL_ACCESS_LOG_HOST=192.168.0.6
MSSQL_ACCESS_LOG_PORT=1433
MSSQL_ACCESS_LOG_DATABASE=xsys_geba
MSSQL_ACCESS_LOG_USER=sa
MSSQL_ACCESS_LOG_PASSWORD=change_me

# Tabla donde se leen los accesos
MSSQL_ACCESS_LOG_TABLE=CD_ES

# Driver ODBC
MSSQL_ACCESS_LOG_DRIVER={ODBC Driver 18 for SQL Server}

# Límite por defecto de registros
MSSQL_ACCESS_LOG_DEFAULT_LIMIT=10

# ==================================================
# xSys - Espejo local (app `xsys`)
# ==================================================
MSSQL_XSYS_ENABLED=1
MSSQL_XSYS_HOST=192.168.0.6
# El puerto real del MSSQL es 49331 (no 1433)
MSSQL_XSYS_PORT=49331
MSSQL_XSYS_DATABASE=xsys_geba
MSSQL_XSYS_USER=sa
MSSQL_XSYS_PASSWORD=change_me
MSSQL_XSYS_DRIVER={ODBC Driver 18 for SQL Server}
# Obligatorio o falla el handshake TLS contra el 49331
MSSQL_XSYS_ENCRYPT=no
MSSQL_XSYS_TRUST_CERT=yes
MSSQL_XSYS_LOGIN_TIMEOUT=15
MSSQL_XSYS_QUERY_TIMEOUT=60
MSSQL_XSYS_BATCH_SIZE=1000
# Acceso usado para recalcular la lista blanca general (Cuota Social = 22)
MSSQL_XSYS_WHITELIST_ACCESO=22
MSSQL_XSYS_WHITELIST_CONTROLADOR=0

# ==================================================
# BioStar 2 (New Local API)
# ==================================================
BIOSTAR_BASE_URL=https://10.0.0.27
BIOSTAR_USERNAME=admin
BIOSTAR_PASSWORD=change_me
BIOSTAR_VERIFY_TLS=0
BIOSTAR_TIMEOUT_SECONDS=15
# Sincronización automática de rostros (hook del sync xSys + contenedor de backfill).
# off (default, seguro) | dryrun (solo loguea) | on (enrola de verdad).
BIOSTAR_FACE_SYNC_MODE=off
# Lado mayor (px) al que se redimensiona la foto antes de enrolar (evita el 500 del server).
BIOSTAR_FACE_MAX_SIDE=600
# Segundos entre pasadas del contenedor de backfill (biostar-face-sync).
BIOSTAR_FACE_SYNC_INTERVAL=3600
